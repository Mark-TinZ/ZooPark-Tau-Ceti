[internationalization]

locale/translations=PackedStringArray("res://localization.ru.translation", "res://localization.en.translation")

[layer_names]

3d_physics/layer_1="Default"
3d_physics/layer_2="Terrain"
3d_physics/layer_3="Buildings"
3d_physics/layer_4="Camera"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
occlusion_culling/use_occlusion_culling=true

[editor_plugins]
debug_menu/enabled=true
